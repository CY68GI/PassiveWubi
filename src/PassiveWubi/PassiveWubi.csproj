<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PassiveWubi</AssemblyName>
    <RootNamespace>PassiveWubi</RootNamespace>
    <ApplicationIcon>Assets\PassiveWubi.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Authors>CY68GI</Authors>
    <Company>CY68GI</Company>
    <Product>肌忆五笔</Product>
    <Description>PassiveWubi 肌忆五笔 - 潜移默化学习五笔的桌面置顶键盘</Description>
    <Copyright>Copyright © 2026 CY68GI</Copyright>
    <RepositoryUrl>https://github.com/CY68GI/PassiveWubi</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PassiveWubi.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PassiveWubi.Core\PassiveWubi.Core.csproj" />
  </ItemGroup>

</Project>
