<UserControl x:Class="PassiveWubi.Views.PracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource InkBrush}"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <TabControl Background="Transparent" BorderThickness="0">
        <TabItem Header="速度测试">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="速度测试" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="选择内置文章或输入自定义文字，设置测试时间后开始。"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       Margin="0,5,0,16" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="测试文字" VerticalAlignment="Center" />
                                <ComboBox x:Name="SpeedTextCombo"
                                          Grid.Column="1"
                                          AutomationProperties.Name="速度测试文字"
                                          Margin="0,0,18,0"
                                          SelectionChanged="SpeedText_Changed" />
                                <TextBlock Grid.Column="2" Text="测试时间"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="SpeedMinutesInput"
                                         Grid.Column="3"
                                         AutomationProperties.Name="速度测试时间分钟数"
                                         Text="3"
                                         MaxLength="2"
                                         Padding="8,7"
                                         Margin="0,0,18,0"
                                         ToolTip="可设置 1–50 分钟" />
                                <Button x:Name="SpeedStartButton"
                                        Grid.Column="4"
                                        Content="开始测试"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="SpeedStart_Click" />
                            </Grid>
                            <TextBox x:Name="CustomTextInput"
                                     Height="78"
                                     Margin="100,12,0,0"
                                     Padding="10"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Visibility="Collapsed"
                                     Text="在这里输入自定义测试文字。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="测试文本" FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="SpeedTimerText"
                                           Grid.Column="1"
                                           Text="03:00"
                                           FontFamily="Consolas"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}" />
                            </Grid>
                            <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18"
                                    Margin="0,0,0,14">
                                <TextBlock x:Name="SpeedTargetText"
                                           Text="准备好后点击“开始测试”。"
                                           FontSize="18"
                                           LineHeight="31"
                                           TextWrapping="Wrap" />
                            </Border>
                            <TextBox x:Name="SpeedInput"
                                     AutomationProperties.Name="速度测试输入框"
                                     MinHeight="150"
                                     Padding="14"
                                     FontSize="17"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     TextChanged="SpeedInput_TextChanged"
                                     PreviewKeyDown="SpeedInput_PreviewKeyDown" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="速度 " Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="SpeedCpmText" Text="0 字/分钟"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="   正确率 " Margin="18,0,0,0"
                                               Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="SpeedAccuracyText" Text="0%"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="   已输入 " Margin="18,0,0,0"
                                               Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="SpeedCountText" Text="0 字"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="重新开始"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="SpeedReset_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="键位练习">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="练习类型" VerticalAlignment="Center" />
                            <ComboBox x:Name="PracticeKindCombo"
                                      Grid.Column="1"
                                      AutomationProperties.Name="键位练习类型"
                                      Margin="0,0,18,0"
                                      SelectedIndex="2"
                                      SelectionChanged="PracticeKind_Changed">
                                <ComboBoxItem Content="五笔口诀练习" Tag="mnemonic" />
                                <ComboBoxItem Content="五笔字根练习" Tag="root" />
                                <ComboBoxItem Content="五笔拆字练习" Tag="character" />
                                <ComboBoxItem Content="五笔词组练习" Tag="phrase" />
                            </ComboBox>
                            <TextBlock x:Name="SubcategoryLabel"
                                       Grid.Column="2"
                                       Text="拆字分类"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="SubcategoryCombo"
                                      Grid.Column="3"
                                      AutomationProperties.Name="键位练习分类"
                                      SelectionChanged="Subcategory_Changed" />
                            <TextBlock x:Name="VersionLabelText"
                                       Grid.Column="4"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PracticeCategoryText"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="PracticeProgressText"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="16,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="正确率 "
                                               Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="PracticeAccuracyText"
                                               Text="0%"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    MinHeight="170"
                                    Padding="24"
                                    Margin="0,16,0,16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="题目"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11"
                                               HorizontalAlignment="Center" />
                                    <TextBlock x:Name="PracticePromptText"
                                               Text="正在加载题目…"
                                               FontSize="34"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               LineHeight="44"
                                               HorizontalAlignment="Center"
                                               Margin="0,10,0,0" />
                                    <TextBlock x:Name="PracticeHintText"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PracticeAnswerInput"
                                         AutomationProperties.Name="五笔编码输入框"
                                         MinHeight="42"
                                         Padding="12,8"
                                         FontFamily="Consolas"
                                         FontSize="20"
                                         CharacterCasing="Lower"
                                         ToolTip="输入五笔编码，按 Enter 提交"
                                         PreviewKeyDown="PracticeAnswer_PreviewKeyDown" />
                                <Button Grid.Column="1"
                                        Content="提交"
                                        AutomationProperties.Name="提交五笔编码"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="10,0,0,0"
                                        Click="PracticeSubmit_Click" />
                                <Button Grid.Column="2"
                                        Content="下一题"
                                        AutomationProperties.Name="下一道练习题"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0"
                                        Click="PracticeNext_Click" />
                            </Grid>

                            <Border x:Name="PracticeFeedbackBorder"
                                    Background="{DynamicResource SurfaceSubtleBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="12"
                                    Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="PracticeFeedbackText"
                                               Text="选择练习类型后开始答题。" />
                                    <TextBlock x:Name="PracticeBreakdownText"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
