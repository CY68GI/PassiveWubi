<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PassiveWubi.Linux.Views"
        x:Class="PassiveWubi.Linux.Views.MainWindowView"
        Title="肌忆五笔 PassiveWubi"
        Width="1040"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="avares://PassiveWubi.Linux/Assets/PassiveWubi.ico">
    <Grid RowDefinitions="78,*">
        <Border Grid.Row="0" BorderBrush="#33000000" BorderThickness="0,0,0,1">
            <Grid Margin="28,0" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="肌忆五笔 · 设置" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="Ubuntu Linux 首发支持 · 字根表与 Windows 版保持一致"
                               Opacity="0.62" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Content="切换为浅色"
                            Margin="0,0,10,0" Click="Theme_Click" />
                    <Button Content="显示置顶键盘" Classes="accent" Click="ShowKeyboard_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="24,18,24,24"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="键盘与学习">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <Border CornerRadius="14" Padding="24" Background="#263951">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="让视线先学会，让手指随后记住"
                                               FontSize="23" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="置顶键盘直接显示当前五笔版本的实际字根表，不显示助记歌。"
                                               Foreground="#C5D0DF" TextWrapping="Wrap" MaxWidth="620" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                        <Button Content="显示键盘" Classes="accent" Click="ShowKeyboard_Click" />
                                        <Button Content="隐藏键盘" Click="HideKeyboard_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Width="126" Height="126" CornerRadius="63"
                                        Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="当前版本" Foreground="#AEBACB" FontSize="11"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="HeroVersionText" Foreground="White"
                                                   FontSize="26" FontWeight="Bold" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Text="五笔版本" VerticalAlignment="Center" />
                                <ComboBox x:Name="VersionCombo" Grid.Column="1" Width="220"
                                          HorizontalAlignment="Left" SelectionChanged="Version_Changed">
                                    <ComboBoxItem Content="五笔 86 版" Tag="V86" />
                                    <ComboBoxItem Content="五笔 98 版" Tag="V98" />
                                    <ComboBoxItem Content="五笔新世纪版" Tag="NewCentury" />
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="透明度" Margin="0,18,0,0"
                                           VerticalAlignment="Center" />
                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,60" Margin="0,18,0,0">
                                    <Slider x:Name="OpacitySlider" Minimum="0.25" Maximum="1"
                                            ValueChanged="Opacity_Changed" />
                                    <TextBlock x:Name="OpacityValueText" Grid.Column="1"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Grid.Row="2" Text="整体大小" Margin="0,14,0,0"
                                           VerticalAlignment="Center" />
                                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,60" Margin="0,14,0,0">
                                    <Slider x:Name="ScaleSlider" Minimum="0.60" Maximum="1.45"
                                            ValueChanged="Scale_Changed" />
                                    <TextBlock x:Name="ScaleValueText" Grid.Column="1"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="12" Margin="0,20,0,0">
                                    <CheckBox x:Name="SimpleCodesCheck" Content="显示一级简码"
                                              Click="Option_Changed" />
                                    <CheckBox x:Name="RootTableCheck" Content="显示字根表"
                                              Click="Option_Changed" />
                                    <CheckBox x:Name="HighlightCheck"
                                              Content="每 5 秒轻提示一个键位（潜移默化模式）"
                                              Click="Option_Changed" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="13">
                                <TextBlock Text="启动与更新" FontSize="17" FontWeight="SemiBold" />
                                <CheckBox x:Name="ShowOnStartupCheck"
                                          Content="启动软件时显示置顶键盘" Click="Option_Changed" />
                                <CheckBox x:Name="AutoUpdateCheck"
                                          Content="启动时自动检查更新" Click="Option_Changed" />
                                <CheckBox x:Name="AutostartCheck"
                                          Content="登录 Ubuntu 桌面后自动启动" Click="Autostart_Changed" />
                                <TextBlock Text="Linux 自启动写入 ~/.config/autostart/passivewubi.desktop"
                                           Opacity="0.58" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="打开今日日志" Click="OpenTodayLog_Click" />
                            <Button Content="打开日志目录" Click="OpenLogFolder_Click" />
                            <Button Content="打开键盘" Click="ShowKeyboard_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="打字练习">
                <views:PracticeView x:Name="PracticeViewControl" />
            </TabItem>

            <TabItem Header="关于">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="12" Padding="22">
                            <StackPanel Spacing="11">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Background="#DE5F4C" CornerRadius="9" Padding="8,4">
                                        <TextBlock Text="v1.2.0" Foreground="White" FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="打字练习" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="2026-11-10" Opacity="0.6" />
                                <TextBlock TextWrapping="Wrap" LineHeight="23"
                                           Text="• 新增速度测试和 1–50 分钟计时&#10;• 新增口诀、字根、拆字和词组练习&#10;• 拆字与词组题库随 86/98/新世纪版本切换&#10;• Windows 与 Ubuntu 共用题库和答案判定" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="12" Padding="22">
                            <Grid ColumnDefinitions="70,*,Auto">
                                <Border Width="58" Height="58" CornerRadius="16" Background="#DE5F4C">
                                    <TextBlock Text="五" Foreground="White" FontSize="30" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="肌忆五笔" FontSize="24" FontWeight="Bold" />
                                    <TextBlock Text="PassiveWubi for Linux" Opacity="0.62" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="#22DE5F4C" CornerRadius="12" Padding="11,6"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutVersionText" Foreground="#F08D7F"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,16,*">
                            <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="软件信息" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="中文名称：肌忆五笔" />
                                    <TextBlock Text="英文名称：PassiveWubi" />
                                    <TextBlock Text="Linux 客户端：C# / Avalonia 12" />
                                    <TextBlock Text="共享数据：.NET 10 跨平台字根库" />
                                    <TextBlock Text="第一批支持：Ubuntu 22.04 / 24.04 x64" />
                                    <TextBlock Text="许可证：MIT" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#33000000" BorderThickness="1"
                                    CornerRadius="12" Padding="20">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Linux 显示说明" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="置顶与透明效果依赖桌面合成器。Ubuntu GNOME 默认可用。"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="托盘图标在 GNOME 中可能需要 AppIndicator 扩展；主窗口和键盘内始终提供替代入口。"
                                               TextWrapping="Wrap" Opacity="0.7" />
                                    <Button Content="打开 GitHub 仓库" Margin="0,8,0,0" Click="OpenRepository_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="10">
                                <TextBlock Text="运行日志" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="便携目录可写时，日志保存在程序目录的 logs 文件夹；否则使用 XDG 状态目录。"
                                           Opacity="0.68" TextWrapping="Wrap" />
                                <TextBlock x:Name="LogPathText" FontFamily="monospace" FontSize="11"
                                           TextWrapping="Wrap" Opacity="0.58" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="打开今日日志" Click="OpenTodayLog_Click" />
                                    <Button Content="日志目录" Click="OpenLogFolder_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="软件更新" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="UpdateStatusText" Text="尚未检查更新"
                                               Opacity="0.65" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button x:Name="ReleaseButton" Content="打开发布页"
                                            IsVisible="False" Click="OpenReleasePage_Click" />
                                    <Button x:Name="CheckUpdateButton" Content="检查更新"
                                            Click="CheckUpdate_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#44C74C3A" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="退出肌忆五笔" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="关闭主窗口只会隐藏；需要完全结束后台时从这里退出。"
                                               Opacity="0.66" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="完全退出" Click="Exit_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="更新日志">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="12" Padding="22">
                            <StackPanel Spacing="11">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Background="#DE5F4C" CornerRadius="9" Padding="8,4">
                                        <TextBlock Text="v1.1.0" Foreground="White" FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="Ubuntu Linux 支持" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="2026-11-10" Opacity="0.6" />
                                <TextBlock TextWrapping="Wrap" LineHeight="23"
                                           Text="• 新增独立的 Avalonia Linux 客户端&#10;• 首批支持 Ubuntu 22.04 / 24.04 x64&#10;• 支持置顶字根键盘、透明度、缩放、深浅主题&#10;• 支持 Linux 托盘、主窗口隐藏和 XDG 自启动&#10;• Windows 与 Linux 共用五笔版本和字根数据层" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="12" Padding="22">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Linux 兼容范围" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="当前包面向 Ubuntu 桌面 x64，建议在 X11 或 Ubuntu 默认的 XWayland 环境运行。其他发行版尚未提供官方支持。"
                                           TextWrapping="Wrap" Opacity="0.7" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
